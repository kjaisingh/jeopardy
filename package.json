{
  "name": "jeopardy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "env -u SUPABASE_URL -u SUPABASE_SERVICE_ROLE_KEY HOST_GRACE_MS=50 node --test server/*.test.js src/*.test.js",
    "test:e2e": "VITE_E2E_TIMER_SECONDS=1 VITE_SERVER_URL=http://localhost:3001 npm run build && node e2e/smoke.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "nanoid": "^5.1.16",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "playwright": "^1.64.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
