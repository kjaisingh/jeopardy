# Backend
PORT=3001
CLIENT_URL=http://localhost:5173

# Frontend (Vite, local dev only)
VITE_SERVER_URL=http://localhost:3001

# Supabase (optional — enables durable room persistence; omit to run in-memory only)
# Project URL only, e.g. https://xxxx.supabase.co — NOT the /rest/v1/ endpoint.
# SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key (Settings -> API). Bypasses RLS by design.
# SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Server-only secret protecting the scheduled persistence probe.
# Generate with: openssl rand -base64 32
# KEEPALIVE_TOKEN=<random 32-byte secret>

# Optional durability/lifecycle tuning
# PERSISTENCE_TIMEOUT_MS=3000
# PERSISTENCE_RETRY_BASE_MS=1000
# PERSISTENCE_RETRY_MAX_MS=30000
# ROOM_RETENTION_HOURS=24
